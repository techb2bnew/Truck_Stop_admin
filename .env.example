# Copy this file to .env and fill in the two values from Supabase:
# Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: prefill the login form (works on localhost and on Vercel).
# Warning: VITE_ variables are written into the public website, so anyone who opens the site can read these.
# VITE_DEV_LOGIN_EMAIL=
# VITE_DEV_LOGIN_PASSWORD=
